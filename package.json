{
  "name": "aiqe-github-capstone",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub UI + API automation framework using Playwright, TypeScript, AI and GitHub Actions",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test tests/api",
    "test:integrated": "playwright test tests/integrated",
    "test:capstone": "playwright test tests/ui tests/api tests/integrated",
    "test:smoke": "playwright test --grep @smoke",
    "auth:save": "tsx scripts/save-auth-state.ts",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^20.14.0",
    "dotenv": "^16.4.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
