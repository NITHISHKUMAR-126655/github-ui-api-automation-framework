# Copy to .env and fill in. NEVER commit .env. NEVER paste these values into chat or AI prompts.
# Names are prefixed with AIQE_ because GitHub Actions does not allow secrets that start with GITHUB_.
AIQE_UI_BASE_URL=https://github.com
AIQE_API_BASE_URL=https://api.github.com
# Set to true only on a trusted network that uses an intercepting certificate authority
AIQE_IGNORE_HTTPS_ERRORS=true
AIQE_GITHUB_USER=NITHISHKUMAR-126655
AIQE_GITHUB_TOKEN=your_token_here
AIQE_TEST_REPO=github-ui-api-automation-framework.git
# Optional: path of the Playwright storage state created by `npm run auth:save`
AIQE_STORAGE_STATE=playwright/.auth/github.json
